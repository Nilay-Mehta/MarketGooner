# ==============================================================================
# FREE API KEYS & TOKENS CONFIGURATION
# Fill in at least ONE of the following (Groq or Gemini recommended for free tier)
# ==============================================================================

# Groq Console: https://console.groq.com (14,400 free req/day for Llama 3.3 / 3.1)
GROQ_API_KEYS=gsk_your_groq_key_1,gsk_your_groq_key_2

# Google AI Studio: https://aistudio.google.com (1,500 free req/day for Gemini 2.0 / 1.5)
GEMINI_API_KEYS=AIzaSy_your_gemini_key_1,AIzaSy_your_gemini_key_2

# Hugging Face: https://huggingface.co/settings/tokens (Free Serverless Inference)
HUGGINGFACE_API_KEY=hf_your_huggingface_token

# Optional: Discord or Telegram Webhook for real-time mobile alerts
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Path to your Obsidian Vault (for direct scan export)
VAULT_SCANS_PATH=D:/Start/Market_Intelligence_Vault/06_Market_Scans
